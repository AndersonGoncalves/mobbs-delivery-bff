{
  "name": "mobbs-delivery-bff",
  "version": "1.0.0",
  "private": true,
  "description": "BFF (Node.js/Restify) do ecossistema mobbs-delivery — consumido por mobbs-delivery-app e mobbs-delivery-web.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "seed:restaurant": "ts-node --transpile-only scripts/seed-restaurant.ts",
    "seed:catalog": "ts-node --transpile-only scripts/seed-catalog.ts",
    "seed:additional-group-templates": "ts-node --transpile-only scripts/seed-additional-group-templates.ts",
    "seed:additional-group-option-images": "ts-node --transpile-only scripts/seed-additional-group-option-images.ts",
    "seed:highlights": "ts-node --transpile-only scripts/seed-highlights.ts",
    "seed:help-articles-restaurante": "ts-node --transpile-only scripts/seed-help-articles-restaurante.ts",
    "seed:help-articles-cardapio": "ts-node --transpile-only scripts/seed-help-articles-cardapio.ts",
    "seed:help-articles-pedido": "ts-node --transpile-only scripts/seed-help-articles-pedido.ts",
    "seed:help-articles-caixa": "ts-node --transpile-only scripts/seed-help-articles-caixa.ts",
    "seed:help-articles-financeiro": "ts-node --transpile-only scripts/seed-help-articles-financeiro.ts",
    "seed:help-articles-estoque": "ts-node --transpile-only scripts/seed-help-articles-estoque.ts",
    "seed:help-articles-relatorios": "ts-node --transpile-only scripts/seed-help-articles-relatorios.ts",
    "seed:help-articles-graficos": "ts-node --transpile-only scripts/seed-help-articles-graficos.ts",
    "seed:help-articles-acessorios": "ts-node --transpile-only scripts/seed-help-articles-acessorios.ts",
    "seed:help-articles-integracoes": "ts-node --transpile-only scripts/seed-help-articles-integracoes.ts",
    "seed:help-articles-aplicativos": "ts-node --transpile-only scripts/seed-help-articles-aplicativos.ts",
    "seed:help-articles-configuracoes": "ts-node --transpile-only scripts/seed-help-articles-configuracoes.ts",
    "reset:test-restaurant": "ts-node --transpile-only scripts/reset-test-restaurant.ts",
    "set:billing-status": "ts-node --transpile-only scripts/set-billing-status.ts",
    "set:platform-config": "ts-node --transpile-only scripts/set-platform-config.ts",
    "activate:asaas-integration": "ts-node --transpile-only scripts/set-platform-config.ts -- --key=asaasIntegrationEnabled --value=true",
    "activate:mercadopago-integration": "ts-node --transpile-only scripts/set-platform-config.ts -- --key=mercadoPagoIntegrationEnabled --value=true",
    "activate:ifood-integration": "ts-node --transpile-only scripts/set-platform-config.ts -- --key=ifoodIntegrationEnabled --value=true",
    "activate:99food-integration": "ts-node --transpile-only scripts/set-platform-config.ts -- --key=ninetyNineFoodIntegrationEnabled --value=true",
    "activate:kds-app": "ts-node --transpile-only scripts/set-platform-config.ts -- --key=kdsAppEnabled --value=true",
    "activate:comanda-app": "ts-node --transpile-only scripts/set-platform-config.ts -- --key=comandaAppEnabled --value=true",
    "activate:totem-app": "ts-node --transpile-only scripts/set-platform-config.ts -- --key=totemAppEnabled --value=true",
    "activate:instagram-automation": "ts-node --transpile-only scripts/set-platform-config.ts -- --key=instagramAutomationEnabled --value=true",
    "loadtest:seed": "ts-node --transpile-only scripts/load-test/seed.ts",
    "loadtest:emulator": "firebase emulators:start --only auth --project mobbs-delivery-app",
    "loadtest:fixtures": "ts-node --transpile-only scripts/load-test/k6/generate-fixtures.ts",
    "loadtest:api": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 SERVER_PORT=3099 ts-node-dev --respawn --transpile-only src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@sentry/node": "^11.10.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.10.0",
    "json-bigint": "^1.0.0",
    "mongoose": "^8.6.0",
    "nodemailer": "^10.0.3",
    "pino": "^10.3.1",
    "restify": "^11.1.0",
    "restify-errors": "^8.0.2",
    "zod": "^4.5.4"
  },
  "overrides": {
    "find-my-way": "^9.10.0",
    "send": "^1.2.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/restify": "^8.5.12",
    "@types/restify-errors": "^4.3.9",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
