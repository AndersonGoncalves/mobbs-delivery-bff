SERVER_PORT=3001
DB_URL=mongodb://localhost:27017/mobbs-delivery
MONGO_USER=mobbs
MONGO_PASSWORD=changeme

# specs/0023-portabilidade-dados — SMTP genérico (qualquer provedor: Gmail SMTP em dev,
# SES/SendGrid/Mailgun em produção). Sem essas variáveis, o envio de e-mail falha em runtime,
# mas isso nunca trava o cliente (fire-and-forget, REQ-5).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mobbs-delivery.com.br

# specs/0036-migracao-imagens-s3 — sem AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY aqui de propósito:
# credenciais resolvidas pela cadeia padrão do SDK (IAM Role da instância EC2 em produção; rode
# `aws configure` localmente pra desenvolvimento).
S3_BUCKET_NAME=mobbs-delivery-images
AWS_REGION=us-east-1
