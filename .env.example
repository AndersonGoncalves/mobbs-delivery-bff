SERVER_PORT=3001
DB_URL=mongodb://localhost:27017/mobbs-delivery
MONGO_USER=mobbs
MONGO_PASSWORD=changeme

# specs/0023-portabilidade-dados — SMTP genérico (qualquer provedor: Gmail SMTP em dev,
# SES/SendGrid/Mailgun em produção). Sem essas variáveis, o envio de e-mail falha em runtime,
# mas isso nunca trava o cliente (fire-and-forget, REQ-5).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mobbs-delivery.com.br

# specs/0036-migracao-imagens-s3 — sem AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY aqui de propósito:
# credenciais resolvidas pela cadeia padrão do SDK (IAM Role da instância EC2 em produção; rode
# `aws configure` localmente pra desenvolvimento).
S3_BUCKET_NAME=mobbs-delivery-images
AWS_REGION=us-east-1

# specs/0069 — origem pública do app do cliente, usada nos links de acompanhamento do WhatsApp
# (<origem>/<slug>/track?token=...). Padrão: https://bsdelivery.com.br
PUBLIC_APP_BASE_URL=https://bsdelivery.com.br

# specs/0106 — e-mails (separados por vírgula) com acesso ao painel da plataforma (/plataforma no web).
PLATFORM_ADMIN_EMAILS=

# specs/0112 REQ-9 — chave de criptografia da chave Pix do cliente: 32 bytes em base64.
# Gerar com: openssl rand -base64 32
PIX_KEY_ENCRYPTION_KEY=

# specs/0123-prospeccao-restaurantes-google-maps — chave de SERVIDOR (Places API New), nunca
# exposta no cliente. Sem ela, a busca de prospects lança erro claro (REQ-8), o resto do BFF
# continua funcionando normalmente.
GOOGLE_PLACES_API_KEY=

# Mercado Pago: Application ID numérico e Client Secret da MESMA aplicação (OAuth).
# Guia completo: docs/MERCADO-PAGO.md. Nunca colocar segredos em VITE_*.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://bsdelivery.com.br/painel/settings/mercadopago/callback
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# Endereço HTTPS público do BFF, usado em notification_url.
BFF_PUBLIC_BASE_URL=https://api.bsdelivery.com.br

# Facebook/Instagram (automação de postagens, pedido explícito do usuário — follow-up): appId/
# appSecret são da aplicação registrada no Meta for Developers (developers.facebook.com/apps),
# com os produtos "Facebook Login" e "Instagram Graph API" configurados. Guia completo:
# docs/FACEBOOK-INSTAGRAM.md. Nunca colocar segredos em VITE_*.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://bsdelivery.com.br/painel/settings/instagram-automation/callback

# specs/0175-cobranca-assinatura-asaas — cobrança da ASSINATURA da plataforma (lojista paga a
# plataforma), via a MESMA conta mãe do Asaas já usada acima (ASAAS_API_KEY/ASAAS_BASE_URL, não
# redeclaradas aqui). BILLING_PIX_KEY_TYPE é sempre "CPF"; BILLING_PIX_KEY é o CPF do titular,
# nunca commitado de verdade (preencher só no ambiente privado/deploy); ASAAS_BILLING_WEBHOOK_TOKEN
# é um segredo PRÓPRIO (gerar com `openssl rand -hex 24`), nunca o mesmo de ASAAS_API_KEY nem dos
# tokens por-restaurante de specs/0101/0170.
BILLING_PIX_KEY_TYPE=CPF
BILLING_PIX_KEY=
BILLING_PIX_BENEFICIARY_NAME=
ASAAS_BILLING_WEBHOOK_TOKEN=

# specs/0090-integracao-ifood — diferente do Mercado Pago/Facebook acima: sem credencial de
# nível-plataforma aqui, `clientId`/`clientSecret` são por restaurante (digitados na retaguarda,
# Integrações → iFood). Só a URL base da API muda por ambiente. Guia completo: docs/IFOOD.md.
IFOOD_BASE_URL=https://merchant-api.ifood.com.br

# specs/0122-integracao-99food — diferente do iFood acima: `app_id`/`app_secret` SÃO credenciais
# de nível de app (plataforma mobbs, cadastradas uma única vez no portal de parceiro 99Food,
# developer-food.99app.com), nunca por restaurante. Sem elas, "Gerar link para autorizar"
# (Integrações → 99Food) responde erro. Guia completo: docs/99FOOD.md.
NINETY_NINE_FOOD_BASE_URL=https://openapi.99food.com
NINETY_NINE_FOOD_APP_ID=
NINETY_NINE_FOOD_APP_SECRET=
